 0  1  0  0.0
 0  0  1  0.0
%endblock kgrid_Monkhorst_Pack
ForceAuxCell       T
MeshCutoff         200 Ry
PAO.BasisType      split
PAO.BasisSize      DZP
PAO.EnergyShift    0.03 eV
XC.functional      GGA
XC.authors         PBE
