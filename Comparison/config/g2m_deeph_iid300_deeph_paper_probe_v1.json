  "manual_search_plan": {
    "description": "Single DeepH paper-like GPU probe on iid300. Hyperparameters follow the graphene paper direction where possible: lr=1e-3, batch=12, Adam, LCMP enabled. Criterion is MaskMSELoss because this DeepH-pack hamiltonian target rejects plain MSELoss.",
    "planned_runs": [
      {
        "config_id": "DH-PAPER-IID300-LR1E3-B12",
        "model": "deeph",
        "dataset_id": "graphene_w90_phase1_iid300",
        "notes": "Exploratory probe only: verifies CUDA path and rough runtime; not a final scientific comparison.",
        "common": {
          "seed": 2201
        },
        "overrides": {
          "epochs": 120,
          "learning_rate": 0.001,
          "batch_size": 12,
          "optimizer": "adam",
          "weight_decay": 0.0,
          "criterion": "MaskMSELoss",
          "atom_fea_len": 128,
          "edge_fea_len": 128,
          "gauss_stop": 6,
          "num_l": 5,
          "if_edge_update": true,
          "if_lcmp": true,
          "normalization": "LayerNorm",
          "atom_update_net": "CGConv",
          "retain_edge_fea": true,
          "seed": 2201
        }
      }
    ]
  },
  "claim_policy": {
    "scientific_status": "exploratory_probe_only",
    "not_for_final_claims": true,
    "reason": "Runs one DeepH configuration only and skips validation spectral/DOS metrics to focus on CUDA/runtime validation."
  }
}
