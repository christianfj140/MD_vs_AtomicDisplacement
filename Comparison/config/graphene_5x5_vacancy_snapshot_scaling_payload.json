  "deeph": {
    "atom_fea_len": 192,
    "atom_update_net": "CGConv",
    "batch_size": 4,
    "criterion": "MaskMSELoss",
    "device": "cuda:0",
    "disable_cuda": false,
    "edge_fea_len": 192,
    "epochs": 750,
    "gauss_stop": 6,
    "if_edge_update": true,
    "if_lcmp": true,
    "learning_rate": 0.0003,
    "multiprocessing": 0,
    "normalization": "LayerNorm",
    "num_l": 4,
    "num_threads": 2,
    "optimizer": "adamW",
    "retain_edge_fea": true,
    "weight_decay": 0.0
  },
  "description": "Generacion de datasets SIESTA MD para graphene 5x5 monovacancy (49 atomos). Misma configuracion que los datasets pristinos: blocked_with_gap, temporal_gap 1, splits 0.8/0.1/0.1 y reparto termico 20% 150K / 60% 300K / 20% 450K. Solo genera datasets; no entrena.",
  "early_stopping": {
    "max_epochs": 600,
    "metric": "val_loss",
    "min_delta": 0.0,
    "mode": "min",
    "patience": 80
  },
  "graph2mat_overrides": {
    "batch_size": 40,
    "correlation": 3,
    "hidden_irreps": "64x0e + 64x1o + 64x2e + 64x3o",
    "loader_threads": 4,
    "loss": "graph2mat.metrics.block_type_huber",
    "loss_kwargs": {
      "beta": 0.006
    },
    "max_ell": 3,
    "max_epochs": 750,
    "num_interactions": 3,
    "optim_lr": 0.0018,
    "readout": "edge_node_mix",
    "seed_everything": 0
  },
  "material": {
    "mode": "preset",
    "preset": "graphene_5x5_vacancy"
  },
  "material_preset": "graphene_5x5_vacancy",
  "metric_fail_policy": "fail_closed",
  "notes": {
    "intended_use": "Datasets propios de MD para la vacante, para usarla como SOURCE de entrenamiento.",
    "expected_dataset_sizes": [
      30,
      60,
      80,
      100,
      200,
      400,
      500
    ],
    "temperature_distribution": "20% a 150 K, 60% a 300 K, 20% a 450 K en cada tamano.",
    "scientific_policy": "Config identica a la del pristino salvo el material; asi la curva es comparable.",
    "concurrencia": "max_parallel_siesta_jobs subido de 1 a 4: la campana pristina midio 31 s/snapshot en serie, asi que la generacion era enteramente secuencial. 4 jobs x omp_num_threads 2 = ~8 hilos de 24.",
    "pipeline_config": "CRITICO: el runner solo sobrescribe paths/md.steps/md.temperature_blocks/splits del pipeline_config; NO toca material.preset, md.system_label, md.run_fdf_template ni md.atoms. Con el config del pristino se habrian generado datasets de 50 atomos etiquetados como vacante."
  },
  "output_root": "${REPO_ROOT}/Comparison/results/graphene_5x5_vacancy_snapshot_scaling",
  "overwrite_datasets": false,
  "performance": {
    "compute_accelerator": "gpu",
    "enable_experiment_cache": false,
    "error_policy": "continue_on_error",
    "graph2mat_check_val_every_n_epoch": 1,
    "graph2mat_checkpoint_every_n_epochs": 1,
    "graph2mat_log_every_n_steps": 1,
    "graph2mat_require_cuequivariance": true,
    "max_parallel_dataset_jobs": 1,
    "max_parallel_deeph_training_jobs": 2,
    "max_parallel_evaluation_jobs": 3,
    "max_parallel_graph2mat_training_jobs": 2,
    "max_parallel_metric_jobs": 8,
    "max_parallel_prediction_jobs": 1,
    "max_parallel_siesta_jobs": 4,
    "mkl_num_threads": 2,
    "model_batch_schedule": "alternating",
    "model_batch_start": "deeph",
    "numexpr_num_threads": 2,
    "omp_num_threads": 2,
    "openblas_num_threads": 2,
    "preset": "paper_ready_parallel_trains_snapshot_scaling_no_global_batch",
    "reuse_validated_siesta_outputs": true,
    "store_in_memory": true,
    "torch_float32_matmul_precision": "high",
    "torch_mixed_precision": "bf16-mixed",
    "torch_num_threads": 2
  },
  "pipeline_config": "Comparison/config/graphene_5x5_vacancy_pipeline_config.yaml",
  "repair_mode": "disabled",
  "require_run_output": true,
  "require_tsde": true,
  "require_tshs": true,
