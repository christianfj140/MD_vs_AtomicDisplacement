{
  "description": "Graphene 5x2 snapshot-scaling payload cloned from the 200-1200 600-epoch 2-seed payload. It keeps the same 600-epoch Graph2Mat/DeepH anchor hyperparameters and protocol, changes the dataset sizes to 12,100,300,500,700,900,1100,1300, and runs one unseeded training per model anchor and dataset.",
  "source_reference_payloads": [
    "Comparison/config/graphene_5x2_snapshot_scaling_200_1200_600epochs_2seeds_payload.json"
  ],
  "pipeline_config": "Comparison/config/graphene_5x2_snapshot_scaling_20_100_4seeds_pipeline_config.yaml",
  "material_preset": "graphene_5x2",
  "material": {
    "mode": "preset",
    "preset": "graphene_5x2"
  },
  "dataset_mode": "full_strict_pipeline",
  "run_mode": "full_strict_pipeline",
  "dataset_root": "${REPO_ROOT}/Comparison/datasets/graphene_5x2_snapshot_scaling_12_1300_600epochs_1train",
  "output_root": "${REPO_ROOT}/Comparison/results/graphene_5x2_snapshot_scaling_12_1300_600epochs_1train",
  "system_label": "graphene_5x2",
  "require_tshs": true,
  "require_tsde": true,
  "require_run_output": true,
  "allow_repair": false,
  "repair_mode": "disabled",
  "allow_diagnostic_metrics": false,
  "metric_fail_policy": "fail_closed",
  "split_mode": "blocked_with_gap",
  "temporal_gap": 1,
  "block_order": "train,validation,test",
  "splits": {
    "train": 0.8,
    "validation": 0.1,
    "test": 0.1
  },
  "performance": {
    "preset": "paper_ready_parallel_trains_snapshot_scaling_no_global_batch",
    "compute_accelerator": "gpu",
    "store_in_memory": true,
    "reuse_validated_siesta_outputs": true,
    "enable_experiment_cache": false,
    "max_parallel_dataset_jobs": 1,
    "max_parallel_siesta_jobs": 3,
    "max_parallel_prediction_jobs": 1,
    "max_parallel_evaluation_jobs": 3,
    "max_parallel_metric_jobs": 8,
    "max_parallel_graph2mat_training_jobs": 7,
    "max_parallel_deeph_training_jobs": 5,
    "model_batch_schedule": "alternating",
    "model_batch_start": "deeph",
    "omp_num_threads": 2,
    "mkl_num_threads": 2,
    "openblas_num_threads": 2,
    "numexpr_num_threads": 2,
    "torch_num_threads": 2,
    "torch_float32_matmul_precision": "high",
    "torch_mixed_precision": "bf16-mixed",
    "graph2mat_log_every_n_steps": 1,
    "graph2mat_check_val_every_n_epoch": 1,
    "graph2mat_checkpoint_every_n_epochs": 1,
    "graph2mat_require_cuequivariance": true,
    "error_policy": "continue_on_error"
  },
