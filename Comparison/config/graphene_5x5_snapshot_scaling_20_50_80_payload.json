{
  "description": "Graphene 5x5 dataset-generation payload for iid20/iid50/iid80 mixing compatibility testing. Generates SIESTA MD datasets only; no model training.",
  "source_reference_payloads": [
    "Comparison/config/graphene_5x5_snapshot_scaling_20_50_payload.json"
  ],
  "pipeline_config": "Comparison/config/graphene_5x5_snapshot_scaling_20_50_pipeline_config.yaml",
  "material_preset": "graphene_5x5",
  "material": {
    "mode": "preset",
    "preset": "graphene_5x5"
  },
  "dataset_mode": "generate_new",
  "run_mode": "generate_datasets_only",
  "dataset_root": "${REPO_ROOT}/Comparison/datasets/graphene_5x5_snapshot_scaling_20_50_80",
  "output_root": "${REPO_ROOT}/Comparison/results/graphene_5x5_snapshot_scaling_20_50_80",
  "system_label": "graphene_5x5",
  "require_tshs": true,
  "require_tsde": true,
  "require_run_output": true,
  "allow_repair": false,
  "repair_mode": "disabled",
  "allow_diagnostic_metrics": false,
  "metric_fail_policy": "fail_closed",
  "split_mode": "blocked_with_gap",
  "temporal_gap": 1,
  "block_order": "train,validation,test",
  "splits": {
    "train": 0.8,
    "validation": 0.1,
    "test": 0.1
  },
  "performance": {
    "preset": "paper_ready_parallel_trains_snapshot_scaling_no_global_batch",
    "compute_accelerator": "gpu",
    "store_in_memory": true,
    "reuse_validated_siesta_outputs": true,
    "enable_experiment_cache": false,
    "max_parallel_dataset_jobs": 1,
    "max_parallel_siesta_jobs": 1,
    "max_parallel_prediction_jobs": 1,
    "max_parallel_evaluation_jobs": 3,
    "max_parallel_metric_jobs": 8,
    "max_parallel_graph2mat_training_jobs": 7,
    "max_parallel_deeph_training_jobs": 5,
    "model_batch_schedule": "alternating",
    "model_batch_start": "deeph",
    "omp_num_threads": 2,
    "mkl_num_threads": 2,
    "openblas_num_threads": 2,
    "numexpr_num_threads": 2,
    "torch_num_threads": 2,
    "torch_float32_matmul_precision": "high",
    "torch_mixed_precision": "bf16-mixed",
    "graph2mat_log_every_n_steps": 1,
    "graph2mat_check_val_every_n_epoch": 1,
    "graph2mat_checkpoint_every_n_epochs": 1,
    "graph2mat_require_cuequivariance": true,
    "error_policy": "continue_on_error"
  },
  "dataset_sweep": {
    "enabled": true,
    "max_datasets": 3,
    "recipes": [
      {
        "recipe_id": "graphene_5x5_scale_iid20",
        "label": "Graphene 5x5 IID scale: 20 snapshots",
        "size": 20,
        "thermal_regime": "iid_mixed",
        "split_intent": "IID mixed temperature train/validation/test with blocked temporal gap.",
        "blocks": [
          {
            "block_id": "graphene_5x5_scale_iid20_T150_4_1",
            "label": "4 snapshots @ 150 K",
            "n_snapshots": 4,
            "temperature_K": 150,
            "seed": 150020
          },
          {
            "block_id": "graphene_5x5_scale_iid20_T300_12_2",
            "label": "12 snapshots @ 300 K",
            "n_snapshots": 12,
            "temperature_K": 300,
            "seed": 300020
          },
          {
            "block_id": "graphene_5x5_scale_iid20_T450_4_3",
            "label": "4 snapshots @ 450 K",
            "n_snapshots": 4,
            "temperature_K": 450,
            "seed": 450020
          }
        ]
      },
      {
        "recipe_id": "graphene_5x5_scale_iid50",
        "label": "Graphene 5x5 IID scale: 50 snapshots",
        "size": 50,
        "thermal_regime": "iid_mixed",
        "split_intent": "IID mixed temperature train/validation/test with blocked temporal gap.",
        "blocks": [
          {
            "block_id": "graphene_5x5_scale_iid50_T150_10_1",
            "label": "10 snapshots @ 150 K",
            "n_snapshots": 10,
            "temperature_K": 150,
            "seed": 150050
          },
          {
            "block_id": "graphene_5x5_scale_iid50_T300_30_2",
            "label": "30 snapshots @ 300 K",
            "n_snapshots": 30,
            "temperature_K": 300,
            "seed": 300050
          },
          {
            "block_id": "graphene_5x5_scale_iid50_T450_10_3",
            "label": "10 snapshots @ 450 K",
            "n_snapshots": 10,
            "temperature_K": 450,
            "seed": 450050
          }
        ]
      },
      {
        "recipe_id": "graphene_5x5_scale_iid80",
        "label": "Graphene 5x5 IID scale: 80 snapshots",
        "size": 80,
        "thermal_regime": "iid_mixed",
        "split_intent": "IID mixed temperature train/validation/test with blocked temporal gap.",
        "blocks": [
          {
            "block_id": "graphene_5x5_scale_iid80_T150_16_1",
            "label": "16 snapshots @ 150 K",
            "n_snapshots": 16,
            "temperature_K": 150,
            "seed": 150080
          },
          {
            "block_id": "graphene_5x5_scale_iid80_T300_48_2",
            "label": "48 snapshots @ 300 K",
            "n_snapshots": 48,
            "temperature_K": 300,
            "seed": 300080
          },
          {
            "block_id": "graphene_5x5_scale_iid80_T450_16_3",
            "label": "16 snapshots @ 450 K",
            "n_snapshots": 16,
            "temperature_K": 450,
            "seed": 450080
          }
        ]
      }
    ]
  },
  "graph2mat_overrides": {
    "max_epochs": 750,
    "optim_lr": 0.0018,
    "batch_size": 40,
    "loader_threads": 4,
    "num_interactions": 3,
    "correlation": 3,
    "max_ell": 3,
    "hidden_irreps": "64x0e + 64x1o + 64x2e + 64x3o",
    "loss": "graph2mat.metrics.block_type_huber",
    "loss_kwargs": {
      "beta": 0.006
    },
    "readout": "edge_node_mix",
    "seed_everything": 0
  },
  "deeph": {
    "device": "cuda:0",
    "disable_cuda": false,
    "num_threads": 2,
    "multiprocessing": 0,
    "epochs": 750,
    "batch_size": 4,
    "learning_rate": 0.0003,
    "criterion": "MaskMSELoss",
    "retain_edge_fea": true,
    "weight_decay": 0.0,
    "optimizer": "adamW",
    "edge_fea_len": 192,
    "normalization": "LayerNorm",
    "atom_update_net": "CGConv",
    "if_lcmp": true,
    "gauss_stop": 6,
    "atom_fea_len": 192,
    "num_l": 4,
    "if_edge_update": true
  },
  "training_sweep": {
    "enabled": false,
    "manual_runs": [],
    "max_runs": 0,
    "apply_to_datasets": []
  },
  "cost_accounting": {
    "dataset_sweep_summary_json": "summary/dataset_sweep_summary.json",
    "dataset_sweep_summary_csv": "summary/dataset_sweep_summary.csv",
    "fields": [
      "dataset_size",
      "blocks",
      "split_counts",
      "generation_seconds",
      "elapsed_seconds",
      "artifact_validation_status",
      "benchmark_manifest_path",
      "frozen_split_manifest_path"
    ],
    "siesta_wall_time_source": "RUN.out timer: Elapsed wall time (sec), plus runner generation_seconds/elapsed_seconds per dataset row."
  },
  "notes": {
    "intended_use": "Fresh graphene_5x5 SIESTA MD dataset generation for mixing compatibility test.",
    "expected_dataset_count": 3,
    "expected_dataset_sizes": [
      20,
      50,
      80
    ],
    "temperature_distribution": "20% at 150 K, 60% at 300 K, 20% at 450 K for every dataset size.",
    "scientific_policy": "Only MD size varies. SIESTA physics/template, material, basis and pseudopotentials are held fixed. Test/validation split policy remains blocked_with_gap.",
    "material_scope": "This payload is graphene-only.",
    "supercell": "5x5 graphene, 50 carbon atoms",
    "fdf_template": "materials/graphene_5x5/RUN.fdf",
    "training": "disabled"
  },
  "overwrite_datasets": false
}
