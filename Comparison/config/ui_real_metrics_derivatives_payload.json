{
  "schema": "ui_real_metrics_derivative_campaign_v1",
  "description": "Derivative-only postprocess for every locally available completed Graph2Mat+DeepH pair exposed by the Mixing datasets and Cross testing 'Cargar metricas reales' views. No model training is permitted.",
  "mixing_summary": "Comparison/results/ml_vs_siesta_mixing_sweep/mixing_sweep_summary.json",
  "cross_summary": "Comparison/results/ml_vs_siesta_cross_structure_sweep/cross_structure_sweep_summary.json",
  "output_root": "Comparison/results/ui_real_metrics_derivatives",
  "derivative": {
    "method": "central",
    "base_split": "test",
    "base_selection_policy": "adaptive_min_fraction",
    "min_base_snapshots": 10,
    "base_fraction": 0.2,
    "base_selection_seed": 0,
    "atoms": ["0"],
    "axes": ["x", "y", "z"],
    "delta_ang": [0.005, 0.01, 0.02],
    "reference_workers": 4,
    "skip_if_exists": true,
    "diagnostic_only": false,
    "require_central": true,
    "graph2mat_prediction_method": "autograd_vectorized",
    "deeph_prediction_method": "autograd_vectorized"
  }
}
