{
  "schema": "g2m_deeph_cross_structure_sweep_payload_v2",
  "description": "E2 (audit 2026-07): strict W90->5x5 transfer curve with a FIXED target. Sources are graphene_w90 N={50,200,500}; every pair evaluates on the SAME frozen test of graphene_5x5_scale_iid500 (50 test structures), so the OOD curve varies only the source size, never the test set. 3 seeds propagated to model init via run_cross_structure_sweep_payload.py (seeds loop -> seed_<s>/ output dirs). Hyperparameters match the 5x5 paper-ready anchors for E1 comparability (P_OOD = E_w90->5x5 / E_5x5->5x5 at equal N). action=preview by default: switch to \"train\" to launch.",
  "action": "preview",
  "models": ["graph2mat", "deeph"],
  "epochs": 600,
  "seed": 0,
  "seeds": [0, 1, 2],
  "confirm_ghost_species_exemption": true,
  "confirm_incomplete_hamiltonian_semantics": true,
  "strict_dataset_validation": false,
  "sources": [
    "Comparison/datasets/graphene_w90_snapshot_scaling/graphene_w90_scale_iid50",
    "Comparison/datasets/graphene_w90_snapshot_scaling/graphene_w90_scale_iid200",
    "Comparison/datasets/graphene_w90_snapshot_scaling/graphene_w90_scale_iid500"
  ],
  "targets": [
    "Comparison/datasets/graphene_5x5_snapshot_scaling_100_500_mixing/graphene_5x5_scale_iid500"
  ],
  "pairs": [
    {
      "size": 50,
      "source": "Comparison/datasets/graphene_w90_snapshot_scaling/graphene_w90_scale_iid50",
      "target": "Comparison/datasets/graphene_5x5_snapshot_scaling_100_500_mixing/graphene_5x5_scale_iid500"
    },
    {
      "size": 200,
      "source": "Comparison/datasets/graphene_w90_snapshot_scaling/graphene_w90_scale_iid200",
      "target": "Comparison/datasets/graphene_5x5_snapshot_scaling_100_500_mixing/graphene_5x5_scale_iid500"
    },
    {
      "size": 500,
      "source": "Comparison/datasets/graphene_w90_snapshot_scaling/graphene_w90_scale_iid500",
      "target": "Comparison/datasets/graphene_5x5_snapshot_scaling_100_500_mixing/graphene_5x5_scale_iid500"
    }
  ],
  "early_stopping": {
    "max_epochs": 600,
    "metric": "val_loss",
    "min_delta": 0.0,
    "mode": "min",
    "patience": 80
  },
  "hyperparams": {
    "graph2mat": {
      "batch_size": 32,
      "correlation": 3,
      "hidden_irreps": "48x0e + 48x1o + 48x2e + 48x3o",
      "loader_threads": 4,
      "loss": "graph2mat.metrics.block_type_huber",
      "loss_kwargs": {
        "beta": 0.01
      },
      "max_ell": 3,
      "max_epochs": 600,
      "num_interactions": 3,
      "optim_lr": 0.0018,
      "readout": "default"
    },
    "deeph": {
      "atom_fea_len": 128,
      "atom_update_net": "CGConv",
      "batch_size": 8,
      "criterion": "MaskMSELoss",
      "edge_fea_len": 128,
      "epochs": 600,
      "gauss_stop": 6,
      "if_edge_update": true,
      "if_lcmp": true,
      "learning_rate": 0.0003,
      "normalization": "LayerNorm",
      "num_l": 4,
      "optimizer": "adamW",
      "retain_edge_fea": true,
      "weight_decay": 0.0001
    }
  },
  "performance": {
    "preset": "paper_ready_parallel_trains_snapshot_scaling_no_global_batch",
    "compute_accelerator": "gpu",
    "store_in_memory": true,
    "reuse_validated_siesta_outputs": true,
    "enable_experiment_cache": false,
    "max_parallel_dataset_jobs": 1,
    "max_parallel_siesta_jobs": 1,
    "max_parallel_prediction_jobs": 1,
    "max_parallel_evaluation_jobs": 3,
    "max_parallel_metric_jobs": 8,
    "max_parallel_graph2mat_training_jobs": 2,
    "max_parallel_deeph_training_jobs": 2,
    "model_batch_schedule": "alternating",
    "model_batch_start": "deeph",
    "omp_num_threads": 2,
    "mkl_num_threads": 2,
    "openblas_num_threads": 2,
    "numexpr_num_threads": 2,
    "torch_num_threads": 2,
    "torch_float32_matmul_precision": "high",
    "torch_mixed_precision": "bf16-mixed",
    "graph2mat_log_every_n_steps": 1,
    "graph2mat_check_val_every_n_epoch": 1,
    "graph2mat_checkpoint_every_n_epochs": 1,
    "graph2mat_require_cuequivariance": true,
    "error_policy": "continue_on_error"
  },
  "notes": [
    "Concurrency 2/2 instead of the paper_ready 7/5: measured peak VRAM per training is 10.3-11.6 GB (5x5 campaign telemetry) on a 32 GB RTX 5090.",
    "Launch: .venv/bin/python Comparison/scripts/run_cross_structure_sweep_payload.py Comparison/config/graphene_w90_to_5x5_cross_structure_fixed_target_iid500_3seeds_payload.json --output-root Comparison/results/ml_vs_siesta_cross_structure_fixed_target_3seeds --result-json Comparison/results/ml_vs_siesta_cross_structure_fixed_target_3seeds/summary.json",
    "P_OOD denominator (5x5->5x5 in-distribution at equal N) comes from the graphene_5x5_snapshot_scaling_complete_paper_ready campaign; do not retrain it here.",
    "Cost estimate from measured telemetry (per seed, serial): G2M 6.0+10.3+18.2 min + DeepH 10.1+36.8+89.8 min ~= 2.9 h; 3 seeds ~= 8.6 h serial before parallel overlap."
  ]
}
