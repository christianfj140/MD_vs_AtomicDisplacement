    ],
    "expected_total_snapshots": 3000,
    "expected_training_runs": 80,
    "temperature_distribution": "20% at 150 K, 60% at 300 K, 20% at 450 K for every dataset size.",
    "paper_ready_parallelism": "Graph2Mat 7 parallel jobs, DeepH 5 parallel jobs, alternating model batches, starting with DeepH.",
    "scientific_policy": "Only MD size varies. SIESTA physics/template, material, basis and pseudopotentials are held fixed. Test/validation split policy remains blocked_with_gap.",
    "material_scope": "This payload is graphene-only.",
    "expected_dataset_sizes": [
      20,
      50
    ],
    "paper_ready_similarity": "Uses two fixed paper-ready anchors per model: G2M-T600-26, G2M-T1000-03, DH-T600-13 and DH-T1000-04. Hyperparameter search is disabled so dataset size remains the main variable.",
    "batch_size_guard": "Graph2Mat anchors use batch_size 40 and 32; DeepH anchors use batch_size 4 and 8. Reject this payload if any generated Graph2Mat config has batch_size > 80.",
    "manual_anchor_configs_per_dataset": 4,
    "discretization_policy": "Dense dataset-size grid from 10 to 500 snapshots, reusing requested/previous scaling sizes where possible: 10,20,25,30,40,50,55,60,70,75,80,90,95,100,120,150,180,200,220,250,280,300,500.",
    "dataset_root_policy": "Uses a fresh dataset root to avoid overwriting or colliding with previous snapshot-scaling datasets that were generated with a different training payload.",
    "source_protocol": "graphene_w90_snapshot_scaling_reuse_10_1000_4seeds, restricted to N<=100",
    "configs_per_dataset": 4,
    "training_seeds": [
      1,
      2,
      3,
      4
    ],
    "supercell": "5x5 graphene, 50 carbon atoms",
    "fdf_template": "materials/graphene_5x5/RUN.fdf",
    "force_constants_used": false,
    "kpoint_mesh": "4x4x1 scaled from primitive 20x20x1",
    "training": "disabled"
  },
  "run_id": "bilayer_graphene_AA_md30_smoke",
  "overwrite_datasets": true
