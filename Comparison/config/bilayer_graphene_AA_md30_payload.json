{
  "description": "Pure twisted-bilayer-graphene AA smoke MD dataset (no hBN substrate).",
  "source_reference_payloads": [],
  "pipeline_config": "Comparison/config/graphene_hbn_bilayer_md_pipeline_config.yaml",
  "material_preset": "bilayer_graphene_AA",
  "material": {
    "mode": "preset",
    "preset": "bilayer_graphene_AA"
  },
  "dataset_mode": "generate_new",
  "run_mode": "generate_datasets_only",
  "dataset_root": "${REPO_ROOT}/Comparison/datasets/bilayer_graphene_AA_md30",
  "output_root": "${REPO_ROOT}/Comparison/results/bilayer_graphene_AA_md30",
  "system_label": "bilayer_graphene_AA",
  "require_tshs": true,
  "require_tsde": true,
  "require_run_output": true,
  "allow_repair": false,
  "repair_mode": "disabled",
  "allow_diagnostic_metrics": false,
  "metric_fail_policy": "fail_closed",
  "split_mode": "blocked_with_gap",
  "temporal_gap": 1,
  "block_order": "train,validation,test",
  "splits": {
    "train": 0.8,
    "validation": 0.1,
    "test": 0.1
  },
  "performance": {
    "preset": "dynamic_cpu_heavy_siesta",
    "compute_accelerator": "gpu",
    "store_in_memory": true,
    "reuse_validated_siesta_outputs": true,
    "enable_experiment_cache": false,
    "max_parallel_dataset_jobs": 1,
    "max_parallel_siesta_jobs": 5,
    "max_parallel_prediction_jobs": 1,
    "max_parallel_evaluation_jobs": 3,
    "max_parallel_metric_jobs": 8,
    "max_parallel_graph2mat_training_jobs": 7,
    "max_parallel_deeph_training_jobs": 5,
    "model_batch_schedule": "alternating",
    "model_batch_start": "deeph",
    "omp_num_threads": 1,
    "mkl_num_threads": 1,
    "openblas_num_threads": 1,
    "numexpr_num_threads": 1,
    "torch_num_threads": 1,
    "torch_float32_matmul_precision": "high",
    "torch_mixed_precision": "bf16-mixed",
    "graph2mat_log_every_n_steps": 1,
    "graph2mat_check_val_every_n_epoch": 1,
    "graph2mat_checkpoint_every_n_epochs": 1,
    "graph2mat_require_cuequivariance": true,
    "error_policy": "continue_on_error"
  },
  "dataset_sweep": {
    "enabled": true,
    "max_datasets": 1,
    "recipes": [
      {
        "recipe_id": "bilayer_graphene_AA_md30",
        "label": "Pure bilayer graphene AA smoke: 30 snapshots",
        "size": 30,
        "thermal_regime": "iid_mixed",
        "split_intent": "IID mixed temperature train/validation/test with blocked temporal gap.",
        "blocks": [
          {
            "block_id": "AA_T150_6",
            "label": "6 snapshots @ 150 K",
            "n_snapshots": 6,
            "temperature_K": 150,
            "seed": 2150
          },
          {
            "block_id": "AA_T300_18",
            "label": "18 snapshots @ 300 K",
            "n_snapshots": 18,
            "temperature_K": 300,
            "seed": 2300
          },
          {
            "block_id": "AA_T450_6",
            "label": "6 snapshots @ 450 K",
            "n_snapshots": 6,
            "temperature_K": 450,
            "seed": 2450
          }
        ]
      }
    ]
  },
  "graph2mat_overrides": {
    "max_epochs": 750,
    "optim_lr": 0.0018,
    "batch_size": 40,
    "loader_threads": 4,
    "num_interactions": 3,
    "correlation": 3,
    "max_ell": 3,
    "hidden_irreps": "64x0e + 64x1o + 64x2e + 64x3o",
    "loss": "graph2mat.metrics.block_type_huber",
    "loss_kwargs": {
      "beta": 0.006
    },
    "readout": "edge_node_mix",
    "seed_everything": 0
  },
  "deeph": {
    "device": "cuda:0",
    "disable_cuda": false,
    "num_threads": 2,
    "multiprocessing": 0,
    "epochs": 750,
    "batch_size": 4,
    "learning_rate": 0.0003,
    "criterion": "MaskMSELoss",
    "retain_edge_fea": true,
    "weight_decay": 0.0,
    "optimizer": "adamW",
    "edge_fea_len": 192,
    "normalization": "LayerNorm",
    "atom_update_net": "CGConv",
    "if_lcmp": true,
    "gauss_stop": 6,
    "atom_fea_len": 192,
    "num_l": 4,
    "if_edge_update": true
  },
  "training_sweep": {
    "enabled": false,
    "manual_runs": [],
    "max_runs": 0,
    "apply_to_datasets": []
  },
  "cost_accounting": {
    "dataset_sweep_summary_json": "summary/dataset_sweep_summary.json",
    "dataset_sweep_summary_csv": "summary/dataset_sweep_summary.csv",
    "fields": [
      "dataset_size",
      "blocks",
      "split_counts",
      "generation_seconds",
      "elapsed_seconds",
      "artifact_validation_status",
      "benchmark_manifest_path",
      "frozen_split_manifest_path"
    ],
    "siesta_wall_time_source": "RUN.out timer: Elapsed wall time (sec), plus runner generation_seconds/elapsed_seconds per dataset row."
  },
  "notes": {
