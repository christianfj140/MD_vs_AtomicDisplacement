SystemName         graphene_5x5
SystemLabel        graphene_5x5

NumberOfAtoms      50
NumberOfSpecies    1

%block ChemicalSpeciesLabel
  1   6  C
%endblock ChemicalSpeciesLabel


%block PAO.Basis
C           2
 n=2   0   1
   4.088
   1.000
 n=2   1   1
   4.870
   1.000
%endblock PAO.Basis


#
# Atomic structure: explicit 5x5x1 graphene supercell
#
# Primitive graphene input:
#   LatticeConstant = 1.467 Ang
#   a1 = (1.5, -0.8660254038, 0)
#   a2 = (1.5,  0.8660254038, 0)
#
# This file uses explicit supercell vectors:
#   A1 = 5 a1
#   A2 = 5 a2
#   A3 = a3
#
# Coordinates are fractional with respect to the 5x5x1 supercell.
# The structure has been shifted so that one C atom is exactly at:
#   (0.5, 0.5, 0.0)
#

LatticeConstant      1.46700 Ang

%block LatticeVectors
   7.5000000000      -4.3301270190        0.0000000000
   7.5000000000       4.3301270190        0.0000000000
   0.0000000000       0.0000000000       20.0000000000
%endblock LatticeVectors

AtomicCoordinatesFormat Fractional

