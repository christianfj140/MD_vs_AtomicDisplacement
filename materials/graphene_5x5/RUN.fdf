#
# k-point sampling
#
# Original primitive cell used 20x20x1.
# For a 5x5x1 supercell, equivalent density is roughly 4x4x1.
#

%block kgrid_Monkhorst_Pack
   4   0   0  0.0
   0   4   0  0.0
   0   0   1  0.0
%endblock kgrid_Monkhorst_Pack


#
# DFT, Grid, SCF
#

XC.functional          GGA
XC.authors             PBE

MeshCutoff             600.0 Ry
MaxSCFIterations       500
DM.MixingWeight        0.1
DM.NumberPulay         5
DM.Tolerance           1.d-4
DM.UseSaveDM           F
SolutionMethod         diagon
ElectronicTemperature  0.075 eV


#
# Raw SIESTA artifacts for Graph2Mat/DeepH fair benchmarking
#

SaveHS                           true
Save.HS                          T
TS.HS.Save                       T
XML.Write                        T

WriteMullikenPop                 1
